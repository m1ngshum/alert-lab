                      "type": "string",
                      "minLength": 1
                    },
                    "freshnessQuery": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxAgeSeconds": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 3600
                    },
                    "values": {
